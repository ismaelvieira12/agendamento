rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Configuração do site (número, Instagram, local, serviços, horários...):
    //  - QUALQUER pessoa pode LER  (para o site mostrar aos clientes)
    //  - Só usuários LOGADOS podem ESCREVER (o painel admin)
    match /config/site {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Bloqueia todo o resto por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
